# .env.example — every environment variable the server reads, beside its default.
#
# The set is closed: 33 distinct names, read from exactly three files
# (`src/config/index.js` for 31, `src/api/middleware/errorHandler.js` for
# NODE_ENV, `scripts/import-history.mjs` for IMPORT_VALIDATION_API). There is no
# dotenv loader. A `.env` file reaches the process only through
# `scripts/restart.sh` (`--env-file=.env`, the pm2 first-start path) or through
# `docker compose`, which reads it for interpolation.
#
# Each value below is the code default, so copying this file to `.env` changes
# nothing. `docker-compose.yml` supplies the container-correct overrides
# (absolute volume paths, PORT=3002, NODE_ENV=production) itself, and that is the
# file to read before changing anything here.

# --- Server ---------------------------------------------------------------
# Code default 3000 (`src/config/index.js:10`), not 3002. nginx proxies to 3002
# (`nginx.conf:51,68,85,101`) and nothing sets it, so a deployment that relies on
# the default is unreachable behind the proxy: set PORT=3002 to match.
PORT=3000
# Dead. Read into `config.server.host` and never consumed — the only bind is
# `listen(port)` (`src/index.js:15`). Kept in the table because the server reads
# it and the README documented it, not because it does anything.
HOST=0.0.0.0
# Must be `production` for any install made with `npm ci --omit=dev`: the
# non-production path selects the pino-pretty transport (`src/config/index.js:67`),
# pino-pretty is a devDependency, and pino throws at import when the target is
# missing — before the server binds. Production also hides internal 500 messages
# (`src/api/middleware/errorHandler.js:83`).
NODE_ENV=development

# --- Cache (milliseconds) -------------------------------------------------
CACHE_BUNDLE_TTL=300000
# Dead. `config.cache.manifestTTL` occurs only on its own definition line.
CACHE_MANIFEST_TTL=600000

# How long the bundle fetch may take before it is abandoned. The bundle is the
# game's whole minified payload (~10 MB across ~140 chunks); the code's default is
# 20 s, and a cold fetch on a slow link is the case this exists for.
BUNDLE_TIMEOUT=20000

# Whether the logger pretty-prints. `NODE_ENV=production` turns it off, and the
# image is built without the pretty transport, so a container that sets this to
# `true` fails before `app.listen`. It exists for a local run.
LOG_PRETTY=false

# --- Live polling of the game's official API ------------------------------
PLATFORM_POLL_INTERVAL=15000
PLATFORM_FAST_POLL_INTERVAL=5000
PLATFORM_MAX_BACKOFF=60000
# Applied to the platform JSON GETs (`src/core/game/platform/client.js:24`), not
# to the bundle fetch (`src/core/game/bundle/resolver.js:12-20`), which has none.
PLATFORM_TIMEOUT=8000
# What the game's own API sees in its logs. The default is `mgjs-data-api/2.1`
# and it names nobody; this used to default to the upstream deployment's URL, so
# our fork introduced itself as somebody else's service on every request. Put your
# own URL here if you want the game's operators to be able to find you.
PLATFORM_USER_AGENT=mgjs-data-api/2.1

# --- Game update detection (sprite resync) --------------------------------
# The whole sprite pipeline's kill switch: `startVersionWatcher()` returns before
# `checkSpritesOnStartup()` (`src/services/spriteSync.js:469-478`) and it is that
# function's only caller. Set false for a container that must not export on first
# boot — this repository has no `sprites_dump/`, so a first boot with it on
# exports the atlas.
VERSION_WATCH_ENABLED=true
VERSION_WATCH_INTERVAL=60000
# `process.exit(0)` one second after a post-update resync (`src/services/spriteSync.js:406-411`).
VERSION_WATCH_RESTART=true

# --- CORS -----------------------------------------------------------------
# `"false"` and nothing else disables it. Per-response `Access-Control-Allow-Origin`
# on every route Express handles — but not on the sprite PNGs nginx serves
# directly, which is what the `add_header` in nginx.conf is for.
CORS_ENABLED=true
CORS_ORIGIN=*

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true
# 60 requests/IP/minute (`src/config/index.js:24`). README.md said 100 until this
# commit; the code is what runs. The SSE limiter is Math.floor(max/10) = 6.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- Game origin ----------------------------------------------------------
GAME_ORIGIN=https://magicgarden.gg
GAME_PAGE_URL=https://magicgarden.gg/r/test

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info

# --- Sprites --------------------------------------------------------------
# Relative to the process's working directory, which is why a container pins it
# to a volume (`/srv/sprites_dump`).
SPRITES_EXPORT_DIR=./sprites_dump

# The opt-in bake: render every crop type over its reachable mutation sets once,
# so a request is a file read rather than a composition. Off by default and off
# means nothing is written. `BAKE=1` renders 69 crop types x 90 sets = 6,210 PNGs,
# measured at ~452 MiB and about 6.5 minutes on this machine — which is also why
# it is opt-in, and why the version watcher re-bakes rather than composing on the
# hot path. Never a whole plant: a plant's space is 90^slots, not 90.
BAKE=0
# Where the baked files land. Empty means `<SPRITES_EXPORT_DIR>/baked`, so an
# operator has one volume to persist. The tree is namespaced by picture layout and
# game version, and a manifest written under another layout is neither served nor
# resumed, so a composer change cannot serve stale pictures.
BAKE_DIR=
# The absolute prefix of the sprite, animation and Rive URLs the API hands out.
# Leave it empty, which is the default: every URL is then built from the request
# that asked for it, so the answer names the host the client actually reached —
# correct on any port, host or proxy name, with nothing to configure. Set it only
# when the public URL genuinely differs from the one this process sees (a CDN, or
# a proxy that rewrites `Host`), because anything set here wins over the request.
# The cached payloads (`/data/plants` and friends) carry paths relative to this
# API either way — a cached response cannot hold one caller's origin.
SPRITES_BASE_URL=

# The address of *this* instance, as the world reaches it: the spec advertises it in
# its `servers` block, and the sprite URL builder falls back to it before using the
# request's own origin. Same rule as `SPRITES_BASE_URL` — empty is the sensible
# default, and empty means "the origin that was asked". Set it when the public URL
# differs from the one this process sees (a CDN, or a proxy that rewrites `Host`),
# and note that the *spec* has nothing else to go on, so a deployment behind a
# proxy that wants a useful `servers` block should set this even if it leaves
# `SPRITES_BASE_URL` empty.
API_PUBLIC_URL=

# --- Pet animations (looping WebP/GIF rendered from the game's Rive file) --
# Without this, the sprite sync forks a Rive render the code measures in tens of
# minutes (`src/services/animationSync.js:15-16`).
PET_ANIMATIONS_ENABLED=true
PET_ANIMATIONS_FORMATS=webp
PET_ANIMATIONS_HEIGHT=256
PET_ANIMATIONS_QUALITY=20
PET_ANIMATIONS_CLIPS=idle,walk,eat,sleep

# --- History (SQLite persistence of shops/weather) ------------------------
# Undocumented in README before now. `false` skips `startHistoryRecorder()`
# (`src/index.js:34`) and therefore the synchronous SQLite open.
HISTORY_ENABLED=true
# Both CWD-relative; pin them to a volume in a container.
HISTORY_DB_PATH=./data/history.sqlite
HISTORY_EVENTS_ENABLED=true
HISTORY_EVENTS_DIR=./data/events

# --- One-off tooling (not the server) -------------------------------------
# Base URL `scripts/import-history.mjs` validates imported items against.
IMPORT_VALIDATION_API=http://localhost:3002
