    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.38.0",
    "helmet": "^8.1.0",
    "pino": "^10.3.0",
    "sharp": "^0.34.5",
